rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOrbitAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'D1KXTtvfbRcN1YZz4DDT1h2pHYh2'
          // Add the second administrator UID here only after verifying it
          // in Firebase Console → Authentication → Users.
        ];
    }

    match /products/{productId}/{fileName} {
      // Product images are publicly viewable; only admins can upload or delete.
      allow read: if true;
      allow create, update: if isOrbitAdmin()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isOrbitAdmin();
    }
  }
}
